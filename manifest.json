{
  "manifest_version": 3,
  "name": "StudyGuard",
  "version": "1.1.0",
  "description": "Explains, word by word, when a ChatGPT or Claude prompt asks for the answer instead of your own thinking.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StudyGuard settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "sites.js",
        "engine.js",
        "perturbation.js",
        "counterfactual.js",
        "breakdownmap.js",
        "gate.js",
        "hint.js",
        "eventlog.js",
        "interceptor.js",
        "journal.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
