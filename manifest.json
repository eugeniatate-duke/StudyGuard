{
  "manifest_version": 3,
  "name": "StudyGuard",
  "version": "0.1.0",
  "description": "Encourages students to attempt a problem before seeking AI assistance.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open StudyGuard"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["engine.js","content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
