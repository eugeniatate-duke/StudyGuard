{
  "manifest_version": 3,
  "name": "StudyGuard",
  "version": "0.8.0",
  "description": "Encourages students to attempt a problem before seeking AI assistance.",
  "permissions": ["storage", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open StudyGuard"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": [
        "sites.js",
        "engine.js",
        "perturbation.js",
        "counterfactual.js",
        "breakdownmap.js",
        "gate.js",
        "eventlog.js",
        "interceptor.js",
        "journal.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
